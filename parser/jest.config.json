{
  "preset": "ts-jest/presets/default-esm",
  "testEnvironment": "node",
  "extensionsToTreatAsEsm": [".ts"],
  "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json", "mjs"],
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", {
      "useESM": true
    }]
  },
  "testMatch": ["**/test/**/*.test.ts"],
  "testPathIgnorePatterns": ["/node_modules/", "/docs/"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
